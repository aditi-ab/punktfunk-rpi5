[Unit]
Description=Punktfunk PipeWire audio service
Requires=punktfunk-prepare.service punktfunk-dbus.service
After=punktfunk-prepare.service punktfunk-dbus.service
PartOf=punktfunk-session.target

[Service]
Type=simple
User=punktfunk
Group=punktfunk
SupplementaryGroups=audio video render
EnvironmentFile=/etc/default/punktfunk
Environment=PIPEWIRE_RUNTIME_DIR=/run/punktfunk
ExecStart=/usr/bin/pipewire
Restart=on-failure
RestartSec=1
# The appliance has no desktop RTKit broker. Give PipeWire's graph thread the
# resource limits it otherwise asks RTKit to grant.
LimitNICE=-11
LimitRTPRIO=88
LimitMEMLOCK=infinity

[Install]
WantedBy=punktfunk-session.target
