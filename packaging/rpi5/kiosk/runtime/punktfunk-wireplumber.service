[Unit]
Description=Punktfunk WirePlumber audio policy
Requires=punktfunk-pipewire.service
After=punktfunk-pipewire.service
PartOf=punktfunk-session.target

[Service]
Type=simple
User=punktfunk
Group=punktfunk
SupplementaryGroups=audio video render
EnvironmentFile=/etc/default/punktfunk
Environment=PIPEWIRE_RUNTIME_DIR=/run/punktfunk
ExecStart=/usr/bin/wireplumber
Restart=on-failure
RestartSec=1

[Install]
WantedBy=punktfunk-session.target
