[Unit]
Description=Punktfunk application session D-Bus
Requires=punktfunk-prepare.service
After=punktfunk-prepare.service
PartOf=punktfunk-session.target

[Service]
Type=simple
User=punktfunk
Group=punktfunk
EnvironmentFile=/etc/default/punktfunk
ExecStart=/usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/punktfunk/bus
Restart=on-failure
RestartSec=1

[Install]
WantedBy=punktfunk-session.target
