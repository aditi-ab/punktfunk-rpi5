<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The host artifact's elevation ask, merged by the linker into the same embedded manifest
     that carries reactor's self-contained activatable-class registrations (build.rs). The
     client artifact must NOT carry this: it is per-user by design (Steam's non-Steam-game
     picker breaks on admin-owned dirs) — M4 adds its bin without the merge. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
