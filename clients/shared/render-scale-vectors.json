{
  "$comment": "Render scale → host Mode, pinned by punktfunk-core render_scale, the Swift RenderScale and the Kotlin RenderScale tests; pf-encode-core checks max_dimension against its Codec walls. A null scale is NaN. `apply` rows take their ceiling from max_dimension(codec).",
  "max_dimension": [
    {"codec": "h264", "max": 4096},
    {"codec": "hevc", "max": 8192},
    {"codec": "av1", "max": 8192},
    {"codec": "pyrowave", "max": 8192},
    {"codec": "auto", "max": 8192}
  ],
  "sanitize": [
    {"raw": 0, "want": 1.0},
    {"raw": -3, "want": 1.0},
    {"raw": null, "want": 1.0},
    {"raw": 0.1, "want": 0.5},
    {"raw": 0.5, "want": 0.5},
    {"raw": 1.5, "want": 1.5},
    {"raw": 4.0, "want": 4.0},
    {"raw": 9.0, "want": 4.0}
  ],
  "apply": [
    {"name": "native", "base": [1920, 1080], "scale": 1.0, "codec": "hevc", "want": [1920, 1080]},
    {"name": "supersample", "base": [1920, 1080], "scale": 2.0, "codec": "av1", "want": [3840, 2160]},
    {"name": "under-render", "base": [1920, 1080], "scale": 0.5, "codec": "auto", "want": [960, 540]},
    {"name": "odd product floors even", "base": [1366, 768], "scale": 1.5, "codec": "hevc", "want": [2048, 1152]},
    {"name": "0.67 stop", "base": [2560, 1440], "scale": 0.67, "codec": "hevc", "want": [1714, 964]},
    {"name": "over the ceiling", "base": [3840, 2160], "scale": 4.0, "codec": "hevc", "want": [8192, 4608]},
    {"name": "h264 ceiling", "base": [1920, 1080], "scale": 4.0, "codec": "h264", "want": [4096, 2304]},
    {"name": "ultrawide h264", "base": [3440, 1440], "scale": 2.0, "codec": "h264", "want": [4096, 1714]},
    {"name": "portrait h264", "base": [1080, 2400], "scale": 3.0, "codec": "h264", "want": [1842, 4096]},
    {"name": "sub-minimum", "base": [400, 300], "scale": 0.5, "codec": "hevc", "want": [320, 200]},
    {"name": "zero base", "base": [0, 0], "scale": 1.0, "codec": "hevc", "want": [320, 200]},
    {"name": "NaN scale is native", "base": [1920, 1080], "scale": null, "codec": "hevc", "want": [1920, 1080]},
    {"name": "zero scale is native", "base": [1920, 1080], "scale": 0.0, "codec": "hevc", "want": [1920, 1080]},
    {"name": "tiny scale clamps", "base": [1920, 1080], "scale": 0.1, "codec": "hevc", "want": [960, 540]},
    {"name": "huge scale clamps", "base": [1280, 720], "scale": 9.0, "codec": "pyrowave", "want": [5120, 2880]}
  ]
}
