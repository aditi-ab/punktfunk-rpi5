+fn recovery_admission_generation(
+    recovery: &Mutex<RecoveryDriver>,
+    dropped: u64,
+    index: u32,
+    complete: bool,
+    decode_order: u64,
+) -> (recovery::RecoveryStep, u64) {
+    let mut recovery = recovery.lock().unwrap();
+    recovery.engage(dropped);
+    let step = recovery.step(
+        RecoveryEvent::Arrived {
+            index,
+            complete,
+            decode_order,
+        },
+        Instant::now(),
+    );
+    (step, recovery.arms())
+}
+
+fn decoded_recovery_at_generation(
+    recovery: &Mutex<RecoveryDriver>,
+    dropped: u64,
+    decoded: Decoded,
+    generation: u64,
+) -> Option<recovery::RecoveryStep> {
+    let mut recovery = recovery.lock().unwrap();
+    recovery.engage(dropped);
+    if recovery.arms() != generation {
+        return None;
+    }
+    Some(recovery.step(RecoveryEvent::Decoded(decoded), Instant::now()))
+}
