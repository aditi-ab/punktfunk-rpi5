+impl Drop for V4l2RequestDecoder {
+    fn drop(&mut self) {
+        unsafe {
+            ffi::av_packet_free(&mut self.packet);
+            ffi::av_frame_free(&mut self.frame);
+            ffi::av_frame_free(&mut self.planar);
+            ffi::avcodec_free_context(&mut self.ctx);
+        }
+    }
+}
