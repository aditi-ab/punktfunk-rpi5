diff --git a/.github/workflows/rpi5-release.yml b/.github/workflows/rpi5-release.yml
new file mode 100644
index 0000000000000000000000000000000000000000..579db10ffe9f5c5058ff710d5bd190a8cd6f7a26
--- /dev/null
+++ b/.github/workflows/rpi5-release.yml
@@ -0,0 +1,138 @@
+name: Raspberry Pi 5 release assets
+
+on:
+  push:
+    tags:
+      - 'v*-rpi5.*'
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Existing draft-release tag to build
+        required: true
+
+permissions:
+  contents: write
+
+concurrency:
+  group: rpi5-release-${{ inputs.tag || github.ref_name }}
+  cancel-in-progress: false
+
+env:
+  RELEASE_TAG: ${{ inputs.tag || github.ref_name }}
+
+jobs:
+  build:
+    runs-on: ubuntu-24.04-arm
+    container: rust:1.96.0-bookworm
+    steps:
+      - name: Check out the release tag
+        uses: actions/checkout@v5
+        with:
+          ref: ${{ env.RELEASE_TAG }}
+          fetch-depth: 0
+
+      - name: Install build dependencies
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends \
+            build-essential ca-certificates clang cmake gh git libasound2-dev \
+            libclang-dev libdbus-1-dev libdecor-0-dev libdrm-dev libgbm-dev \
+            libegl1-mesa-dev libgl1-mesa-dev libgles2-mesa-dev libopus-dev \
+            libpipewire-0.3-dev libpulse-dev libudev-dev \
+            liburing-dev libva-dev libvulkan-dev libwayland-dev libxcursor-dev \
+            libxext-dev libxfixes-dev libxi-dev libxinerama-dev \
+            libxkbcommon-dev libxkbcommon-x11-dev libxrandr-dev libxss-dev \
+            libxtst-dev llvm-dev nasm ninja-build patchelf pkg-config python3 \
+            wayland-protocols
+
+      - name: Verify the separately stored downstream patch snapshot
+        run: |
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          git clone --depth 1 --branch codex/rpi5-patches https://github.com/aditi-ab/punktfunk-rpi5.git "$RUNNER_TEMP/rpi5-patches"
+          python3 "$RUNNER_TEMP/rpi5-patches/tools/patchset.py" verify \
+            --source "$GITHUB_WORKSPACE" --expect-head
+
+      - name: Restore ARM64 build cache
+        uses: actions/cache/restore@v4
+        with:
+          path: |
+            /usr/local/cargo/registry
+            /usr/local/cargo/git
+            target/rpi5-release
+          key: rpi5-arm64-${{ hashFiles('Cargo.lock') }}-${{ github.run_id }}
+          restore-keys: |
+            rpi5-arm64-${{ hashFiles('Cargo.lock') }}-
+            rpi5-arm64-
+
+      - name: Build the portable ARM64 bundle
+        run: |
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          export PF_CONSOLE_DUMP="$GITHUB_WORKSPACE/ui-checks"
+          bash packaging/rpi5/build-release.sh "$RELEASE_TAG" dist
+
+      - name: Keep appliance menu test renders
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: rpi5-menu-checks
+          path: ui-checks/*.png
+          if-no-files-found: ignore
+          retention-days: 7
+
+      - name: Save ARM64 build cache
+        if: always()
+        uses: actions/cache/save@v4
+        with:
+          path: |
+            /usr/local/cargo/registry
+            /usr/local/cargo/git
+            target/rpi5-release
+          key: rpi5-arm64-${{ hashFiles('Cargo.lock') }}-${{ github.run_id }}
+
+      - name: Transfer the exact release bundle to the image builder
+        uses: actions/upload-artifact@v4
+        with:
+          name: rpi5-bundle
+          path: dist/*
+          if-no-files-found: error
+          retention-days: 7
+
+  image:
+    needs: build
+    runs-on: ubuntu-24.04-arm
+    steps:
+      - name: Check out the release tag
+        uses: actions/checkout@v5
+        with:
+          ref: ${{ env.RELEASE_TAG }}
+          fetch-depth: 0
+
+      - name: Download the matching ARM64 bundle
+        uses: actions/download-artifact@v4
+        with:
+          name: rpi5-bundle
+          path: dist
+
+      - name: Install image build dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            curl xz-utils fdisk util-linux e2fsprogs dosfstools python3
+
+      - name: Build and verify the public kiosk image
+        run: |
+          sudo git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          sudo bash packaging/rpi5/kiosk/build-image.sh "$RELEASE_TAG" \
+            "dist/punktfunk-${RELEASE_TAG#v}-linux-arm64.tar.gz" dist
+
+      - name: Upload the bundle and complete image to the matching release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+        run: |
+          if ! gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
+            gh release create "$RELEASE_TAG" --verify-tag --draft \
+              --title "Punktfunk $RELEASE_TAG for Raspberry Pi 5" \
+              --notes "Includes the portable ARM64 bundle and full Raspberry Pi OS kiosk image. Flash the .img.xz with Raspberry Pi Imager. Remote login is disabled by default."
+          fi
+          gh release upload "$RELEASE_TAG" dist/* --clobber
