--- /dev/null
+++ b/packaging/rpi5/kiosk/runtime/wait-for-wayland
@@ -0,0 +1,29 @@
+#!/bin/sh
+set -eu
+
+expected=/run/punktfunk/wayland-0
+echo "PUNKTFUNK_WAYLAND_WAIT expected=${expected}"
+attempt=0
+while [ "$attempt" -lt 45 ]; do
+    for candidate in "${expected}" /run/user/*/wayland-0; do
+        if [ -S "${candidate}" ]; then
+            if [ "${candidate}" != "${expected}" ]; then
+                ln -sf "${candidate}" "${expected}"
+            fi
+            printf 'wayland_socket=%s\n' "${candidate}" >/data/logs/wayland-ready.log
+            echo "PUNKTFUNK_WAYLAND_READY socket=${candidate}"
+            exit 0
+        fi
+    done
+    attempt=$((attempt + 1))
+    sleep 1
+done
+
+{
+    echo 'Wayland socket was not created.'
+    ls -la /run/punktfunk /run/user 2>&1 || true
+    find /run -maxdepth 4 -name 'wayland-*' -ls 2>&1 || true
+} >/data/logs/wayland-timeout.log
+echo 'PUNKTFUNK_WAYLAND_TIMEOUT' >/dev/ttyS0 2>/dev/null || true
+echo 'PUNKTFUNK_WAYLAND_TIMEOUT'
+exit 1
