+        dt: f64,
+        fonts: &Fonts,
+        ctx: &mut Ctx,
+    ) {
+        BluetoothScreen::render(self, canvas, rect, k, dt, fonts, ctx)
+    }
+    fn title(&self) -> String {
+        "Bluetooth devices".into()
+    }
+    fn press(&mut self) {
+        self.list.dip();
+    }
+    fn pan(&mut self, p: Pointer) -> bool {
+        self.list.pan(p)
+    }
+    fn text_input(&mut self, text: &str) {
+        BluetoothScreen::text_input(self, text);
+    }
+    fn edit_key(&mut self, key: crate::input::Key, _ctx: &mut Ctx) -> bool {
+        BluetoothScreen::edit_key(self, key)
+    }
+    fn editing(&self) -> bool {
+        BluetoothScreen::editing(self)
+    }
+    fn edit_field(&self) -> Option<crate::screens::EditField> {
+        BluetoothScreen::edit_field(self)
+    }
+}
